#!/bin/bash
# shellcheck disable=SC2139

# Minimal helpers — sourced before all aliases: commands to edit the bash
# config files themselves. Kept minimal so they work on any host.
# The rest of the cfg-* family (cfg-vim, cfg-ssh, …) lives in .bashrc_alias_cfg.

# Edit the bashrc loader / the system alias dir / the per-user alias dir / this file
alias cfg-bashrc="edit ~/.bashrc && source ~/.bashrc"
alias cfg-alias-common="sudo vim /etc/bash_aliases.d && source ~/.bashrc"
alias cfg-alias-custom="edit ~/.config/bash_aliases.d && source ~/.bashrc"
alias cfg-alias-minimal="edit ~/.config/bashrc/.bashrc_aliases_minimal && source ~/.bashrc"