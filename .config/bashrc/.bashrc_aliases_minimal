#!/bin/bash
# shellcheck disable=SC2139

# Minimal helpers — sourced before all aliases: commands to edit the bash
# config files themselves. Kept minimal so they work on any host.

# Edit the main config / this file. The cfg-* family (cfg-bashrc,
# cfg-alias-common, cfg-alias-custom, …) lives in .bashrc_alias_cfg.
alias erc='${EDITOR:-vim} ~/.config/bashrc/.bashrc'
alias ercm='${EDITOR:-vim} ~/.config/bashrc/.bashrc_aliases_minimal'